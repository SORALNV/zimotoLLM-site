<article class="article-row">
  <div class="article-meta"><time datetime="{{ article.date | isoDate }}">{{ article.date | dateLabel }}</time><span>{{ article.data.author | authorName }}</span></div>
  <div class="article-summary">
    <div class="topics">{% for topic in article.data.topics %}<a href="{{ topic | topicUrl }}">{{ topic }}</a>{% endfor %}</div>
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    <p>{{ article.data.description }}</p>
    <a class="read-link" href="{{ article.url }}" aria-label="{{ article.data.title }}を読む">記事を読む <span aria-hidden="true">→</span></a>
  </div>
</article>
