<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="skip" href="#main">本文へ移動</a>
  <header class="header wrap">
    <a class="brand" href="/" aria-label="地元LLM トップ"><span class="brand-symbol" aria-hidden="true">地</span>地元<span class="latin">LLM</span></a>
    <nav aria-label="メインナビゲーション">
      <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>記事</a>
      <a href="/contribute/" {% if page.url == '/contribute/' %}aria-current="page"{% endif %}>記事を書く</a>
      <a href="{{ site.repo }}">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main" class="wrap">{{ content | safe }}</main>
  <footer class="footer wrap"><span>地元LLM <span class="muted">／ ローカルLLMの共同ノート</span></span><a href="{{ site.repo }}">ソースコード・編集はこちら ↗</a></footer>
</body>
</html>
